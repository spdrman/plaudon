{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.local/schemas/compatibility-register.v1.schema.json",
  "title": "Compatibility claim register v1",
  "description": "Schema for compatibility.yaml (spec 2.5B). Every user-visible compatibility string is generated from this register. A profile tuple that matches no cell fails closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "vendor",
        "device_model",
        "firmware_range",
        "host_os",
        "os_version_range",
        "auth_mode",
        "provisioning_method",
        "transport",
        "codec",
        "quality_class",
        "evidence_level",
        "status"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "device_model": {
          "type": "string",
          "minLength": 1
        },
        "hardware_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "firmware_range": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "host_os": {
          "type": "string",
          "minLength": 1
        },
        "os_version_range": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "auth_mode": {
          "type": "string",
          "minLength": 1
        },
        "provisioning_method": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "minLength": 1
        },
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "quality_class": {
          "type": "string",
          "minLength": 1
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "observed_on_identified_hardware",
            "implemented_not_verified",
            "proposed",
            "unsupported"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "experimental",
            "supported",
            "known_unsupported"
          ]
        },
        "test_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_verified_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "verified_import_recorded": {
          "type": "boolean"
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "test_run_id",
              "last_verified_at",
              "verified_import_recorded"
            ],
            "properties": {
              "evidence_level": {
                "const": "observed_on_identified_hardware"
              },
              "test_run_id": {
                "type": "string",
                "minLength": 1
              },
              "last_verified_at": {
                "type": "string"
              },
              "verified_import_recorded": {
                "const": true
              },
              "firmware_range": {
                "minItems": 1
              },
              "os_version_range": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
