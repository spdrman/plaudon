{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/events/ui-event.v1.schema.json",
  "title": "ui-event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "kind",
    "occurred_at",
    "job_id",
    "recording_id",
    "payload"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "job.updated",
        "job.failed",
        "recording.imported",
        "recording.source_updated",
        "transcript.completed",
        "tool.completed",
        "model.availability_changed",
        "model.install_progress",
        "consent.required",
        "source.auth_required",
        "source.sync_finished",
        "library.changed",
        "activity.added",
        "ui.activation_requested",
        "device.discovered",
        "device.connected",
        "device.compatibility_changed",
        "device.transfer_progress",
        "device.transfer_verified",
        "device.disconnected",
        "voiceprofile.suggestions_ready",
        "person.changed"
      ]
    },
    "occurred_at": {
      "type": "string"
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "recording_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "description": "Opaque hint payload. For ui.activation_requested it carries {\"target\": {\"kind\": \"recording\"|\"job\"|\"settings\", \"id\": string|null}}. Device events carry {\"peripheral_id\": string} and, for transfers, recording_id, transfer_id and state."
    }
  }
}
