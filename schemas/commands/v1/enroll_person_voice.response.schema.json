{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/enroll_person_voice.response.schema.json",
  "title": "enroll_person_voice.response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "person_id",
    "exemplar_id",
    "exemplars",
    "speech_ms",
    "total_speech_ms",
    "source_recordings",
    "model_id",
    "model_version",
    "retention_months",
    "expires_at"
  ],
  "properties": {
    "person_id": {
      "type": "string",
      "format": "uuid"
    },
    "exemplar_id": {
      "type": "string",
      "format": "uuid"
    },
    "exemplars": {
      "type": "integer",
      "minimum": 0
    },
    "speech_ms": {
      "type": "integer",
      "minimum": 0
    },
    "total_speech_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source_recordings": {
      "type": "integer",
      "minimum": 0
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "retention_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "expires_at": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}
