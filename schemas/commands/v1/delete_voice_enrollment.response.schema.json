{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/delete_voice_enrollment.response.schema.json",
  "title": "delete_voice_enrollment.response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applied",
    "exemplars",
    "suggestions",
    "person_kept",
    "person"
  ],
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "exemplars": {
      "type": "integer",
      "minimum": 0
    },
    "suggestions": {
      "type": "integer",
      "minimum": 0
    },
    "person_kept": {
      "type": "boolean"
    },
    "person": {
      "$ref": "#/$defs/person"
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "display_name",
        "aliases",
        "email",
        "organisation",
        "status",
        "created_at",
        "updated_at",
        "recordings",
        "pending_suggestions",
        "voice"
      ],
      "properties": {
        "person_id": {
          "type": "string",
          "format": "uuid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "organisation": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "merged"
          ]
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "recordings": {
          "type": "integer",
          "minimum": 0
        },
        "pending_suggestions": {
          "type": "integer",
          "minimum": 0
        },
        "voice": {
          "$ref": "#/$defs/person_voice"
        }
      }
    },
    "person_voice": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "status",
        "exemplars",
        "source_recordings",
        "total_speech_ms",
        "retention_months",
        "consent_version",
        "enrolled_at",
        "last_matched_at",
        "expires_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "active",
            "expired"
          ]
        },
        "exemplars": {
          "type": "integer",
          "minimum": 0
        },
        "source_recordings": {
          "type": "integer",
          "minimum": 0
        },
        "total_speech_ms": {
          "type": "integer",
          "minimum": 0
        },
        "retention_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "consent_version": {
          "type": "string"
        },
        "enrolled_at": {
          "type": "integer"
        },
        "last_matched_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
