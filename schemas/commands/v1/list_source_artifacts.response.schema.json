{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/list_source_artifacts.response.schema.json",
  "title": "list_source_artifacts.response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifacts"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "source_vendor",
        "content_sha256",
        "byte_length",
        "original_filename",
        "imported_at",
        "import_mode",
        "recorded_at"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "source_vendor": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "original_filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "import_mode": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string"
        }
      }
    }
  }
}
