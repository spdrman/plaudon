{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/generate_study_artifacts.response.schema.json",
  "title": "generate_study_artifacts.response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_id",
    "tool_version",
    "transcript_revision_id",
    "artifacts",
    "rejected",
    "output_ids",
    "tool_run_id",
    "dispatched"
  ],
  "properties": {
    "tool_id": {"type": "string"},
    "tool_version": {"type": "integer", "minimum": 0},
    "transcript_revision_id": {"type": "string"},
    "artifacts": {"$ref": "#/$defs/study_artifacts"},
    "rejected": {
      "type": "array",
      "items": {"$ref": "#/$defs/rejected_item"}
    },
    "output_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tool_run_id": {
      "anyOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "dispatched": {"type": "boolean"}
  },
  "$defs": {
    "study_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flashcards",
        "quiz",
        "definitions"
      ],
      "properties": {
        "flashcards": {
          "type": "array",
          "items": {"$ref": "#/$defs/flashcard"}
        },
        "quiz": {
          "type": "array",
          "items": {"$ref": "#/$defs/quiz_item"}
        },
        "definitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/definition"}
        }
      }
    },
    "flashcard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front", "back", "anchors"],
      "properties": {
        "front": {"type": "string"},
        "back": {"type": "string"},
        "anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/anchor"}
        }
      }
    },
    "quiz_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options", "answer_index", "anchors"],
      "properties": {
        "question": {"type": "string"},
        "options": {
          "type": "array",
          "items": {"type": "string"}
        },
        "answer_index": {"type": "integer", "minimum": 0},
        "anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/anchor"}
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "definition", "anchors"],
      "properties": {
        "term": {"type": "string"},
        "definition": {"type": "string"},
        "anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/anchor"}
        }
      }
    },
    "rejected_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "detail"],
      "properties": {
        "path": {"type": "string"},
        "reason": {
          "type": "string",
          "enum": ["uncited", "all_anchors_rejected", "empty_field"]
        },
        "detail": {"type": "string"}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq_index",
        "char_start",
        "char_end",
        "excerpt",
        "verified",
        "alignment_origin"
      ],
      "properties": {
        "seq_index": {"type": "integer", "minimum": 0},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 0},
        "excerpt": {"type": "string"},
        "verified": {"type": "boolean"},
        "rejection_code": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "matched_text": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "alignment_origin": {
          "type": "string",
          "enum": ["none", "native", "derived"]
        },
        "seek_ms": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
