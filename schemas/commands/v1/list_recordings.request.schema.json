{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/list_recordings.request.schema.json",
  "title": "list_recordings.request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cursor",
    "limit",
    "filter",
    "sort"
  ],
  "properties": {
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "import_status",
        "transcription_status",
        "sources",
        "tags",
        "date_from",
        "date_to"
      ],
      "properties": {
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "import_status": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pending",
              "importing",
              "imported",
              "failed"
            ]
          }
        },
        "transcription_status": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "queued",
              "running",
              "completed",
              "failed",
              "stale"
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_to": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "recorded_at",
            "imported_at",
            "title",
            "duration_ms"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    }
  }
}
