{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/get_recording.response.schema.json",
  "title": "get_recording.response",
  "$ref": "#/$defs/recording_detail",
  "$defs": {
    "error_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "diagnostic_id"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostic_id": {
          "type": "string"
        }
      }
    },
    "recording_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_id",
        "title",
        "recorded_at",
        "imported_at",
        "duration_ms",
        "source",
        "import_status",
        "transcription_status",
        "processing_engine",
        "last_error",
        "tags",
        "byte_length",
        "sha256",
        "media",
        "revisions",
        "current_revision_id",
        "outputs"
      ],
      "properties": {
        "recording_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "recorded_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_at": {
          "type": "string"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_kind",
            "label"
          ],
          "properties": {
            "source_kind": {
              "type": "string",
              "enum": [
                "manual_import",
                "plaud_cloud",
                "plaud_device",
                "watched_folder"
              ]
            },
            "label": {
              "type": "string"
            }
          }
        },
        "import_status": {
          "type": "string",
          "enum": [
            "pending",
            "importing",
            "imported",
            "failed"
          ]
        },
        "transcription_status": {
          "type": "string",
          "enum": [
            "none",
            "queued",
            "running",
            "completed",
            "failed",
            "stale"
          ]
        },
        "processing_engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error_envelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_codec",
            "sample_rate_hz",
            "channels",
            "original_file_name"
          ],
          "properties": {
            "observed_codec": {
              "type": "string"
            },
            "sample_rate_hz": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "channels": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "original_file_name": {
              "type": "string"
            }
          }
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transcript_revision_ref"
          }
        },
        "current_revision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recording_output"
          }
        }
      }
    },
    "recording_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_id",
        "kind",
        "source_revision_id",
        "created_at",
        "stale"
      ],
      "properties": {
        "output_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "summary",
            "actions",
            "decisions"
          ]
        },
        "source_revision_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        }
      }
    },
    "transcript_revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "kind",
        "created_at",
        "engine_id",
        "model_id",
        "alignment_origin",
        "segment_count",
        "superseded"
      ],
      "properties": {
        "revision_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "machine",
            "human"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "engine_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "alignment_origin": {
          "type": "string",
          "enum": [
            "native",
            "derived",
            "none"
          ]
        },
        "segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "superseded": {
          "type": "boolean"
        }
      }
    }
  }
}
