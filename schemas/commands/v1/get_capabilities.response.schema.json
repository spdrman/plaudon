{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/get_capabilities.response.schema.json",
  "title": "get_capabilities.response",
  "$ref": "#/$defs/capabilities",
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "hardware",
        "engines",
        "storage",
        "integrations",
        "permissions",
        "preferences",
        "openrouter_key_present",
        "cloud_consents"
      ],
      "properties": {
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "version"
          ],
          "properties": {
            "platform": {
              "type": "string",
              "enum": [
                "macos",
                "windows",
                "linux"
              ]
            },
            "version": {
              "type": "string"
            }
          }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arch",
            "logical_cores",
            "total_memory_bytes"
          ],
          "properties": {
            "arch": {
              "type": "string"
            },
            "logical_cores": {
              "type": "integer",
              "minimum": 0
            },
            "total_memory_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "engines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/engine_inventory_entry"
          }
        },
        "storage": {
          "$ref": "#/$defs/storage_capability"
        },
        "integrations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "unknown",
              "experimental",
              "supported",
              "unsupported"
            ]
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "granted",
              "denied",
              "not_requested"
            ]
          }
        },
        "preferences": {
          "$ref": "#/$defs/preferences"
        },
        "openrouter_key_present": {
          "type": "boolean"
        },
        "cloud_consents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consent_summary"
          }
        }
      }
    },
    "engine_inventory_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_id",
        "display_name",
        "stage",
        "status",
        "unavailable_reason",
        "installed_models",
        "download_bytes_required",
        "requires_network",
        "catalogue"
      ],
      "properties": {
        "engine_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "enum": [
            "stt",
            "text"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "experimental",
            "supported",
            "unsupported"
          ]
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "installed_models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/installed_model"
          }
        },
        "download_bytes_required": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requires_network": {
          "type": "boolean"
        },
        "catalogue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogue_offer"
          }
        }
      }
    },
    "catalogue_offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "display_name",
        "size_bytes",
        "licence_spdx_id",
        "licence_name",
        "host",
        "file",
        "delivery_host_suffix",
        "recommended_ram_bytes",
        "installed"
      ],
      "properties": {
        "model_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "licence_spdx_id": {
          "type": "string"
        },
        "licence_name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "delivery_host_suffix": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommended_ram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "installed": {
          "type": "boolean"
        }
      }
    },
    "installed_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "display_name",
        "size_bytes",
        "installed"
      ],
      "properties": {
        "model_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "installed": {
          "type": "boolean"
        }
      }
    },
    "export_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "destination_directory",
        "include_speaker_labels",
        "include_timestamps"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "txt",
            "markdown",
            "json",
            "srt",
            "vtt"
          ]
        },
        "destination_directory": {
          "type": [
            "string",
            "null"
          ]
        },
        "include_speaker_labels": {
          "type": "boolean"
        },
        "include_timestamps": {
          "type": "boolean"
        }
      }
    },
    "notification_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "categories"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "import_finished",
            "transcription_finished",
            "requires_attention",
            "cloud_budget_exceeded"
          ],
          "properties": {
            "import_finished": {
              "type": "boolean"
            },
            "transcription_finished": {
              "type": "boolean"
            },
            "requires_attention": {
              "type": "boolean"
            },
            "cloud_budget_exceeded": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onboarding_completed",
        "local_only_mode",
        "default_stt_engine_id",
        "default_text_engine_id",
        "appearance",
        "contrast",
        "notifications",
        "export_defaults"
      ],
      "properties": {
        "onboarding_completed": {
          "type": "boolean"
        },
        "local_only_mode": {
          "type": "boolean"
        },
        "default_stt_engine_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_text_engine_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "appearance": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ]
        },
        "contrast": {
          "type": "string",
          "enum": [
            "standard",
            "high"
          ]
        },
        "notifications": {
          "$ref": "#/$defs/notification_settings"
        },
        "export_defaults": {
          "$ref": "#/$defs/export_defaults"
        }
      }
    },
    "storage_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_path",
        "free_bytes",
        "total_bytes"
      ],
      "properties": {
        "library_path": {
          "type": "string"
        },
        "free_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "consent_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consent_id",
        "purpose",
        "content_type",
        "scope_kind",
        "recording_id",
        "model_id",
        "downstream_provider",
        "required_retention",
        "disclosure_version",
        "granted_at",
        "expires_at",
        "revoked_at"
      ],
      "properties": {
        "consent_id": {
          "type": "string"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "transcription",
            "summarization",
            "transcript_tool",
            "credential_validation"
          ]
        },
        "content_type": {
          "type": "string",
          "enum": [
            "audio_bytes",
            "transcript_text",
            "metadata_only"
          ]
        },
        "scope_kind": {
          "type": "string",
          "enum": [
            "ask_every_time",
            "recording",
            "model_policy"
          ]
        },
        "recording_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": "string"
        },
        "downstream_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_retention": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "zero_retention",
            "limited_retention",
            "provider_default",
            "unknown",
            null
          ]
        },
        "disclosure_version": {
          "type": "string"
        },
        "granted_at": {
          "type": "string"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
