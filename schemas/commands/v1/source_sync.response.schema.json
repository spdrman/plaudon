{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/source_sync.response.schema.json",
  "title": "source_sync.response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "source_id",
    "source_kind",
    "state",
    "folder",
    "listed",
    "imported_recording_ids"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "watched_folder",
        "plaud_cloud"
      ]
    },
    "state": {
      "type": "string"
    },
    "folder": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/counts"
        }
      ]
    },
    "listed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "imported_recording_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanned",
        "inventory_complete",
        "imported",
        "already_imported",
        "deferred",
        "refused_tombstoned",
        "rejected",
        "vanished"
      ],
      "properties": {
        "scanned": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_complete": {
          "type": "boolean"
        },
        "imported": {
          "type": "integer",
          "minimum": 0
        },
        "already_imported": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        },
        "refused_tombstoned": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "vanished": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
