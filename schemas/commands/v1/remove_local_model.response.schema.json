{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/remove_local_model.response.schema.json",
  "title": "remove_local_model.response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bytes_freed",
    "disk"
  ],
  "properties": {
    "bytes_freed": {
      "type": "integer"
    },
    "disk": {
      "$ref": "#/$defs/disk"
    }
  },
  "$defs": {
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed_bytes",
        "staging_bytes"
      ],
      "properties": {
        "installed_bytes": {
          "type": "integer"
        },
        "staging_bytes": {
          "type": "integer"
        }
      }
    }
  }
}
