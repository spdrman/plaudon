{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/list_models.request.schema.json",
  "title": "list_models.request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "engine"
  ],
  "properties": {
    "stage": {
      "$ref": "#/$defs/processing_stage"
    },
    "engine": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "processing_stage": {
      "type": "string",
      "enum": [
        "transcribe",
        "diarize",
        "normalize",
        "section_summary",
        "consolidated_summary",
        "structured_extraction",
        "citation_verification",
        "tool_run"
      ]
    }
  }
}
