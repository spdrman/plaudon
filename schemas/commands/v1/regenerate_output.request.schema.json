{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/regenerate_output.request.json",
  "type": "object",
  "required": ["output_id", "acknowledged"],
  "additionalProperties": false,
  "properties": {
    "output_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "acknowledged": {
      "type": "boolean"
    }
  }
}
