{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.app/schemas/commands/v1/assign_cluster_person.response.schema.json",
  "title": "assign_cluster_person.response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applied",
    "speaker",
    "person",
    "segments_assigned",
    "segment_exceptions"
  ],
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "speaker": {
      "$ref": "#/$defs/speaker"
    },
    "person": {
      "anyOf": [
        {
          "$ref": "#/$defs/person_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "segments_assigned": {
      "type": "integer",
      "minimum": 0
    },
    "segment_exceptions": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker_id",
        "recording_id",
        "label",
        "name",
        "confirmed",
        "original_label",
        "renamed_at",
        "confirmed_at"
      ],
      "properties": {
        "speaker_id": {
          "type": "string",
          "format": "uuid"
        },
        "recording_id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "original_label": {
          "type": "string",
          "minLength": 1
        },
        "renamed_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "confirmed_at": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "person_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "display_name"
      ],
      "properties": {
        "person_id": {
          "type": "string",
          "format": "uuid"
        },
        "display_name": {
          "type": "string"
        }
      }
    }
  }
}
