{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plaudon.local/schemas/openrouter-model-record.v1.schema.json",
  "title": "OpenRouter model probe record v1",
  "description": "One row of the A1.2 per-model verification register (spec 2.5B). A model is offerable for transcription only when evidence is observed_exchange, request_family has a builder, and both provider_route and retention_control were resolved for that exact endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "request_family",
    "evidence",
    "accepted_formats",
    "max_input_bytes",
    "max_duration_ms",
    "timestamps",
    "diarization",
    "language_detection",
    "provider_route",
    "retention_control",
    "audio_input_price",
    "pricing_unit",
    "observed_on"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "request_family": {
      "type": "string",
      "enum": [
        "multipart_stt",
        "audio_chat",
        "unsupported",
        "unknown"
      ]
    },
    "evidence": {
      "type": "string",
      "enum": [
        "observed_exchange",
        "catalog_only",
        "none"
      ]
    },
    "accepted_formats": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "max_input_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max_duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "timestamps": {
      "type": "string",
      "enum": [
        "observed_segments",
        "observed_words",
        "observed_none",
        "not_observed"
      ]
    },
    "diarization": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "language_detection": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "provider_route": {
      "type": [
        "string",
        "null"
      ]
    },
    "retention_control": {
      "type": [
        "string",
        "null"
      ]
    },
    "audio_input_price": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "scaled_amount",
            "scale",
            "currency"
          ],
          "additionalProperties": false,
          "properties": {
            "scaled_amount": {
              "type": "integer"
            },
            "scale": {
              "type": "integer"
            },
            "currency": {
              "type": "string"
            }
          }
        }
      ]
    },
    "pricing_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "audio_tokens_per_second": {
      "description": "Audio input tokens per second of media, measured from an observed exchange that reported both a token count and an audio duration. Null until measured: the catalogue prices audio per token and the token count for a file is not derivable locally.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "observed_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "notes": {
      "type": "string"
    }
  }
}
