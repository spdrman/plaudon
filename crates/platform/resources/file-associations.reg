Windows Registry Editor Version 5.00

; Plaudon file associations. Written at install time by the
; installer and removed by the uninstaller; the running
; application never writes these keys.
; Generated by plaudon-platform; edit crates/platform/src/associations.rs,
; not this file.

[HKEY_CURRENT_USER\Software\Classes\.plaudon]
@="Plaudon.Archive"

[HKEY_CURRENT_USER\Software\Classes\.plaudon\OpenWithProgids]
"Plaudon.Archive"=""

[HKEY_CURRENT_USER\Software\Classes\Plaudon.Archive]
@="Plaudon portable archive"

[HKEY_CURRENT_USER\Software\Classes\Plaudon.Archive\DefaultIcon]
@="\"%EXEPATH%\",0"

[HKEY_CURRENT_USER\Software\Classes\Plaudon.Archive\shell\open\command]
@="\"%EXEPATH%\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\plaudon]
@="URL:Plaudon Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\plaudon\DefaultIcon]
@="\"%EXEPATH%\",0"

[HKEY_CURRENT_USER\Software\Classes\plaudon\shell\open\command]
@="\"%EXEPATH%\" \"%1\""
