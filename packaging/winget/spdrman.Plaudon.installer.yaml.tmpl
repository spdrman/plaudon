# Generated by `plaudon-release packaging render`. Edit the template, not the
# rendered manifest: packaging/winget/spdrman.Plaudon.installer.yaml.tmpl
# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.6.0.schema.json

PackageIdentifier: spdrman.Plaudon
PackageVersion: "@VERSION@"
MinimumOSVersion: 10.0.19041.0
InstallerType: wix
Scope: user
InstallModes:
  - interactive
  - silent
  - silentWithProgress
UpgradeBehavior: install
# Quoted: the schema types ReleaseDate as a string, and an unquoted
# YYYY-MM-DD is a date to most YAML parsers.
ReleaseDate: "@RELEASE_DATE@"
ReleaseNotesUrl: https://github.com/@REPOSITORY@/releases/tag/v@VERSION@
# WinGet installs packages, never npm packages: the official PLAUD Cloud CLI
# (@plaud-ai/cli) cannot be a dependency here. Node.js can, and
# Plaudon-Setup-Plaud.ps1 — installed beside Plaudon.exe — does the rest.
Dependencies:
  PackageDependencies:
    - PackageIdentifier: OpenJS.NodeJS.LTS
Installers:
  - Architecture: x64
    InstallerUrl: @MSI_URL@
    InstallerSha256: @MSI_SHA256_UPPER@
ManifestType: installer
ManifestVersion: 1.6.0
