  "forbidden_permissions": [
    "shell:*",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-open",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "http:*",
    "http:default",
    "http:allow-fetch",
    "fs:*",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:scope",
    "core:webview:allow-print",
    "core:webview:allow-internal-toggle-devtools",
    "core:webview:allow-set-webview-zoom",
    "core:app:allow-default-window-icon",
    "websocket:*",
    "upload:*",
    "process:allow-restart"
  ],
  "required_csp": {
    "default-src": ["'self'"],
    "script-src": ["'self'"],
    "object-src": ["'none'"],
    "base-uri": ["'none'"],
    "frame-src": ["'none'"],
    "form-action": ["'none'"],
    "connect-src": ["'self'", "ipc:", "http://ipc.localhost"]
  },
  "forbidden_command_patterns": [
    "^exec",
    "^execute",
    "^run_shell",
    "^run_command",
    "^shell",
    "^spawn",
    "^http_",
    "^fetch",
    "^proxy",
    "^read_file$",
    "^write_file$",
    "^delete_file$",
    "^list_dir",
    "^open_url",
    "^set_path",
    "^sql",
    "^eval"
  ],
  "release_requirements": {
    "devtools": false,
    "with_global_tauri": false,
    "remote_window_urls": false,
    "dangerous_keys": false
  }
}
